<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: allowBackup="false" no impide la transferencia entre móviles. Nada sale de este
     móvil: las credenciales van cifradas con una clave del Keystore que no viaja, y las faltas son
     datos personales. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
